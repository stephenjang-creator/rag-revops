# Secrets
.env

# Data (raw downloads + built vector store are not committed)
data/raw/
data/processed/

# EXCEPTION: the small prebuilt demo index IS committed so the hosted demo has
# data on cold start (it's baked into the Render/Docker image; ephemeral fs).
# Built from public data only via scripts/build_demo_subset.py + ingest.
!data/processed/chroma/
!data/processed/chroma/**

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS
.DS_Store
desktop.ini
Thumbs.db

# Observability metrics sink (local; regenerated from traffic)
metrics/

# Streamlit local secrets (admin_password, etc.) — never commit
.streamlit/secrets.toml
