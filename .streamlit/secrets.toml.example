# Streamlit secrets template for the local `streamlit run app.py` UI — copy to
# .streamlit/secrets.toml (gitignored) and fill in. (The hosted demo runs on
# Render; there, set ADMIN_TOKEN as an env var and read GET /api/metrics instead.)
#
# app.py bridges these into the environment at startup, so they configure the
# observability layer without any code change.

# Admin metrics panel password for the local Streamlit UI. If unset, the admin
# panel is hidden entirely (metrics still collect silently in the background).
admin_password = "change-me"

# --- Optional: Langfuse tracing --------------------------------------------
# Leave these unset to keep tracing OFF (recommended for the public demo, so
# reviewer queries aren't traced into your project). Set all three to turn
# full request tracing on for this deployment.
# LANGFUSE_PUBLIC_KEY = "pk-lf-..."
# LANGFUSE_SECRET_KEY = "sk-lf-..."
# LANGFUSE_HOST = "https://cloud.langfuse.com"

# --- Optional: metrics sink location ---------------------------------------
# Defaults to metrics/requests.jsonl. Set empty to disable the sink entirely.
# RAG_METRICS_PATH = "metrics/requests.jsonl"
